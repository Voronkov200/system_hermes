# Стандартный .gitignore для Flutter-проекта
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies

# Идеи и инструменты
.idea/
*.iml
.vscode/
*.swp
*.swo

# Android
*.apk
*.aab
*.jks
*.keystore

# macOS / Windows / Linux
.DS_Store
Thumbs.db

# Сгенерированная Android-платформа (создаётся при сборке, CI генерирует заново)
android/
